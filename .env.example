# Somente servidor. NÃO use prefixo VITE_ para qualquer segredo.
APP_URL=https://SEU-DOMINIO.vercel.app
DATABASE_URL=
# Senha nova, com pelo menos 16 caracteres. A anterior estava exposta no navegador.
ADMIN_PASSWORD=
# 32 bytes em hexadecimal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bloqueio adicional. Só habilitar após testar revisão e configurar o canal.
ENABLE_PUBLISH=false
# Importação opcional da fila antiga. Use chave NOVA do JSONBin.
JSONBIN_MASTER_KEY=
JSONBIN_BIN_ID=
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Cadastre exatamente https://SEU-DOMINIO.vercel.app/api/meli-callback no aplicativo ML.
MELI_REDIRECT_URI=
MELI_PKCE=true
MELI_MIN_DISCOUNT=10
MELI_MAX_PRICE=0
# Cron não é instalado automaticamente. Use segredo exclusivo de 32+ caracteres.
CRON_SECRET=
